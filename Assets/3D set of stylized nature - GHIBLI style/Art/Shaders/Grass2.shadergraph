{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "a5b2b7eadf414617b30eebdd19815179",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "GrassSway (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1400,
            "y": -250,
            "width": 260,
            "height": 210
        }
    },
    "m_Slots": [
        {
            "m_Id": "df29842e664645ec964238b1f9c38579"
        },
        {
            "m_Id": "bb29851c13814bd9b650dfcd4d5e9f54"
        },
        {
            "m_Id": "120b2489c0cc41598a22fe6ba7156f2d"
        },
        {
            "m_Id": "812518fa7b244af2b3fa117582281067"
        },
        {
            "m_Id": "2968df5d4c6641c7a1f1e8219958c3b8"
        },
        {
            "m_Id": "e10b7b6e9e9a642a56eda155f0f5f02f"
        },
        {
            "m_Id": "87d4165610f259904b392ea5dc0ea00f"
        },
        {
            "m_Id": "7a0c7c0704fecd9b35ba1b446bb41cec"
        },
        {
            "m_Id": "9728ffb6bc194e77bb148ca674490147"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "GrassSway",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float height = saturate(PositionOS.y * 0.55);\nheight *= height;\nfloat3 rootWS = TransformObjectToWorld(float3(0.0, 0.0, 0.0));\nfloat seed = frac(rootWS.x * 0.1031 + rootWS.z * 0.11369);\nseed = frac(seed * (seed + 33.33));\nfloat phase = PositionWS.x * 0.61 + PositionWS.z * 0.37 + Time * Speed + seed * 2.1;\nfloat wave = sin(phase) * (0.85 + 0.15 * seed);\nfloat2 awayXZ = rootWS.xz - InteractionCenter.xz;\nfloat distanceSqr = dot(awayXZ, awayXZ);\nfloat windRadius = max(InteractionCenter.w * 2.5, 0.1);\nfloat windBlend = saturate(1.0 - distanceSqr / (windRadius * windRadius));\nwindBlend *= windBlend;\nfloat windScale = lerp(0.08, 1.0, windBlend * saturate(InteractionMotion.z));\nfloat tuftVariation = 0.9 + 0.1 * seed;\nfloat sway = wave * min(max(Strength, 0.0), 2.0) * 0.12 * height * windScale * tuftVariation;\nPositionOut = PositionOS + float3(sway, 0.0, sway * 0.45);\nif (InteractionCenter.w > 0.01 && height > 0.0 &&\n    (InteractionMotion.z > 0.001 || InteractionTrail.z > 0.001))\n{\n    float radius = InteractionCenter.w;\n    float radiusSqr = radius * radius;\n    float bestBend = 0.0;\n    float2 chosenAway = float2(0.0, 0.0);\n    float chosenDistance = 0.0;\n\n    if (InteractionMotion.z > 0.001 && distanceSqr > 0.0001 && distanceSqr < radiusSqr)\n    {\n        float distance = sqrt(distanceSqr);\n        float2 awayDirection = awayXZ / distance;\n        float2 travelDirection = normalize(InteractionMotion.xy);\n        float side = abs(travelDirection.x * awayDirection.y - travelDirection.y * awayDirection.x);\n        float sideMask = saturate((side - 0.2) * 1.5);\n        sideMask *= sideMask;\n        float falloff = saturate(1.0 - distance / radius);\n        falloff *= falloff;\n        bestBend = InteractionMotion.z * falloff * sideMask;\n        chosenAway = awayDirection;\n        chosenDistance = distance;\n    }\n\n    if (InteractionTrail.z > 0.001)\n    {\n        float2 trailXZ = rootWS.xz - InteractionTrail.xy;\n        float trailDistanceSqr = dot(trailXZ, trailXZ);\n        if (trailDistanceSqr > 0.0001 && trailDistanceSqr < radiusSqr)\n        {\n            float trailDistance = sqrt(trailDistanceSqr);\n            float2 trailAway = trailXZ / trailDistance;\n            float2 trailDirection = float2(cos(InteractionTrail.w), sin(InteractionTrail.w));\n            float trailSide = abs(trailDirection.x * trailAway.y - trailDirection.y * trailAway.x);\n            float trailSideMask = saturate((trailSide - 0.2) * 1.5);\n            trailSideMask *= trailSideMask;\n            float trailFalloff = saturate(1.0 - trailDistance / radius);\n            trailFalloff *= trailFalloff;\n            float trailBend = InteractionTrail.z * trailFalloff * trailSideMask * 0.85;\n            if (trailBend > bestBend)\n            {\n                bestBend = trailBend;\n                chosenAway = trailAway;\n                chosenDistance = trailDistance;\n            }\n        }\n    }\n\n    if (bestBend > 0.001)\n    {\n        float rotorWave = sin(InteractionCenter.y + seed * 6.2831853 + chosenDistance * 4.0);\n        float pulse = 0.75 + 0.25 * rotorWave;\n        float2 tangent = float2(-chosenAway.y, chosenAway.x);\n        float2 pushDirection = chosenAway + tangent * (0.18 * rotorWave);\n        float variation = 0.72 + seed * 0.55;\n        float push = bestBend * InteractionMotion.w * variation * pulse * height;\n        PositionOut += TransformWorldToObjectDir(float3(pushDirection.x, 0.0, pushDirection.y), false) * push;\n    }\n}"
}

